    <script>
                document.addEventListener("DOMContentLoaded", function () {
            const sidebar = document.getElementById("sidebar");
            const toggleBtn = document.querySelector(".toggle-sidebar-btn");

            // Toggle sidebar when button is clicked
            toggleBtn.addEventListener("click", function () {
                sidebar.classList.toggle("hide");
            });

            // Hide sidebar when clicking outside
            document.addEventListener("click", function (event) {
                if (!sidebar.contains(event.target) && !toggleBtn.contains(event.target)) {
                    sidebar.classList.add("hide");
                }
            });
        });


            //for boxes
                    document.addEventListener("DOMContentLoaded", function () {
            console.log("Dashboard script loaded"); // Debugging message

            // ✅ Initialize Flatpickr (Date Range Picker)
            flatpickr("#dateRangePicker", {
                mode: "range",
                dateFormat: "Y-m-d",
                defaultDate: [new Date(new Date().getFullYear(), new Date().getMonth(), 1), new Date()],
                onChange: function (selectedDates) {
                    if (selectedDates.length === 2) {
                        let startDate = selectedDates[0].toISOString().split('T')[0];
                        let endDate = selectedDates[1].toISOString().split('T')[0];
                        console.log("Selected Dates:", startDate, endDate); // Debugging
                        fetchDashboardData(startDate, endDate);
                    }
                }
            });

            function fetchDashboardData(startDate, endDate) {
                console.log("Fetching data for:", startDate, endDate); // Debugging

                fetch(`/Home/Dashboard?startDate=${startDate}&endDate=${endDate}`, {
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                })
                .then(response => response.json())
                .then(data => {
                    console.log("Data received:", data); // Debugging
                    if (data.success) {
                        // ✅ Update the UI with new data
                        document.getElementById("incomeAmount").innerText = "₹" + data.totalIncome.toLocaleString();
                        document.getElementById("expenseAmount").innerText = "₹" + data.totalExpense.toLocaleString();
                        document.getElementById("balanceAmount").innerText = "₹" + data.balance.toLocaleString();

                        // ✅ Update Doughnut Chart
                        updateDoughnutChart(data.expenseByCategory);
                    } else {
                        console.error("Failed to fetch data:", data.message);
                    }
                })
                .catch(error => console.error("Error fetching dashboard data:", error));
            }

            function updateDoughnutChart(expenseData) {
                console.log("Updating Doughnut Chart:", expenseData); // Debugging

                if (!expenseData || expenseData.length === 0) {
                    console.warn("No expense data available.");
                    return;
                }

                let chartContainer = document.querySelector("#expenseDoughnutChart");
                if (!chartContainer) {
                    console.error("Chart container not found.");
                    return;
                }

                const chart = echarts.init(chartContainer);
                chart.setOption({
                    title: {
                        text: "Expense Breakdown",
                        left: "center"
                    },
                    tooltip: {
                        trigger: "item"
                    },
                    legend: {
                        bottom: 10,
                        left: "center"
                    },
                    series: [{
                        name: "Expenses",
                        type: "pie",
                        radius: ["40%", "70%"], // Doughnut chart
                        avoidLabelOverlap: false,
                        label: {
                            show: false,
                            position: "center"
                        },
                        emphasis: {
                            label: {
                                show: true,
                                fontSize: "18",
                                fontWeight: "bold"
                            }
                        },
                        labelLine: {
                            show: false
                        },
                        data: expenseData.map(item => ({
                            name: item.categoryName,
                            value: item.amount
                        }))
                    }]
                });
            }

            // ✅ Fetch data for the current month on page load
            let today = new Date();
            let defaultStartDate = `${today.getFullYear()}-${(today.getMonth() + 1).toString().padStart(2, '0')}-01`;
            let defaultEndDate = today.toISOString().split('T')[0];
            fetchDashboardData(defaultStartDate, defaultEndDate);
        });

        //Recent Expense

                       function fetchExpenses(page) {
            let pageSize = 5;
            let startDate = document.getElementById("dateRangePicker").value.split(" to ")[0] || "";
            let endDate = document.getElementById("dateRangePicker").value.split(" to ")[1] || "";

            fetch(`/Home/Dashboard?startDate=${startDate}&endDate=${endDate}&page=${page}&pageSize=${pageSize}`, {
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    updateExpensesTable(data.recentExpenses);
                    updatePagination(data.currentPage, data.totalPages);
                }
            })
            .catch(error => console.error("Error fetching expenses:", error));
        }

        // Fetch first page on page load
        document.addEventListener("DOMContentLoaded", function () {
            fetchExpenses(1);
        });


            function updateExpensesTable(expenses) {
            let tbody = document.getElementById("recentExpensesBody");
            tbody.innerHTML = "";

            if (expenses.length > 0) {
                expenses.forEach((expense, index) => {
                    let row = `<tr>
                        <th scope="row">${index + 1}</th>
                        <td>${expense.Category}</td>
                        <td>₹${expense.Amount.toFixed(2)}</td>
                        <td>${new Date(expense.ExpenseDate).toLocaleDateString()}</td>
                    </tr>`;
                    tbody.innerHTML += row;
                });
            } else {
                tbody.innerHTML = "<tr><td colspan='4' class='text-center'>No recent expenses</td></tr>";
            }
        }
               
        function updatePagination(currentPage, totalPages) {
            let pagination = document.getElementById("paginationControls");
            pagination.innerHTML = ""; // Clear previous buttons

            if (totalPages <= 1) return; // Hide pagination if only one page

            let prevDisabled = currentPage <= 1 ? "disabled" : "";
            pagination.innerHTML += `<li class="page-item ${prevDisabled}">
                                        <a class="page-link" href="#" onclick="fetchExpenses(${currentPage - 1})">Previous</a>
                                     </li>`;

            for (let i = 1; i <= totalPages; i++) {
                let active = i === currentPage ? "active" : "";
                pagination.innerHTML += `<li class="page-item ${active}">
                                            <a class="page-link" href="#" onclick="fetchExpenses(${i})">${i}</a>
                                         </li>`;
            }

            let nextDisabled = currentPage >= totalPages ? "disabled" : "";
            pagination.innerHTML += `<li class="page-item ${nextDisabled}">
                                        <a class="page-link" href="#" onclick="fetchExpenses(${currentPage + 1})">Next</a>
                                     </li>`;
        }

        
        // ✅ Fetch expenses for page 1 on page load
        document.addEventListener("DOMContentLoaded", function () {
            fetchExpenses(1);
        });
    </script>

