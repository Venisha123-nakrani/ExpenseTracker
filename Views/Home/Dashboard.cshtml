                                            let today = new Date();

                                            if (range === "day") {
                                                startDate = endDate = today.toISOString().split("T")[0];
                                                document.getElementById("reportSpan").innerText = "/ Today";
                                            } else if (range === "month") {
                                                startDate = new Date(today.getFullYear(), today.getMonth(), 1).toISOString().split("T")[0];
                                                endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0).toISOString().split("T")[0];
                                                document.getElementById("reportSpan").innerText = "/ This Month";
                                            } else {
                                                startDate = new Date(today.getFullYear(), 0, 1).toISOString().split("T")[0];
                                                endDate = new Date(today.getFullYear(), 11, 31).toISOString().split("T")[0];
                                                document.getElementById("reportSpan").innerText = "/ This Year";
                                            }

                                            fetch(`/Home/Dashboard?startDate=${startDate}&endDate=${endDate}`, {
                                                headers: { "X-Requested-With": "XMLHttpRequest" }
                                            })
                                            .then(response => response.json())
                                            .then(data => {
                                                if (data.success) {
                                                    updateSplineChart(data.expensesByDate);
                                                }
                                            })
                                            .catch(error => console.error("Error fetching expense data:", error));
                                        }

                                        function updateSplineChart(expensesByDate) {
                                            let dates = expensesByDate.map(e => e.date);
                                            let expenses = expensesByDate.map(e => e.totalExpense);

                                            let options = {
                                                series: [{ name: "Expenses", data: expenses }],
                                                chart: {
                                                    height: 350,
                                                    type: "line",
                                                    toolbar: { show: false }
                                                },
                                                markers: { size: 4 },
                                                colors: ["#ff771d"],
                                                stroke: { curve: "smooth", width: 3 },
                                                xaxis: {
                                                    categories: dates,
                                                    type: "datetime",
                                                    labels: { format: "dd/MM" }
                                                },
                                                yaxis: { labels: { formatter: val => `₹${val}` } },
                                                tooltip: { x: { format: "dd/MM/yyyy" } }
                                            };

                                            let chartDiv = document.querySelector("#expensesSplineChart");
                                            chartDiv.innerHTML = ""; // Clear previous chart
                                            new ApexCharts(chartDiv, options).render();
                                        }

                                    </script>
                                   
                                    
                                    <!-- End Line Chart -->

                                </div>

                            </div>
                        </div><!-- End Reports -->
                      
                        <!-- Recent Expenses Table -->
                        <div class="col-12">
                            <div class="card recent-sales overflow-auto">
