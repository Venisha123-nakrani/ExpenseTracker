@model ExpenseTracker.Model.Budget

@{
    ViewData["Title"] = "Delete Budget";
}

<div class="dlt">
    <h2>Delete Budget</h2>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @* @if (TempData["SuccessMessage"] != null) *@
    @* { *@
    @*     <div class="alert alert-success"> *@
    @*         @TempData["SuccessMessage"] *@
    @*     </div> *@
    @* } *@

    <div>
        <h4>Are you sure you want to delete this budget?</h4>
        <dl class="row">
            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category.Name</dd>

            <dt class="col-sm-3">Amount</dt>
            <dd class="col-sm-9">₹@Model.Amount.ToString("N2")</dd>

            <dt class="col-sm-3">Month</dt>
            <dd class="col-sm-9">
                @(Model.Month != 0 ? System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month) : "Yearly Budget")
            </dd>

            <dt class="col-sm-3">Year</dt>
            <dd class="col-sm-9">@Model.Year</dd>


        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="BudgetID" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>