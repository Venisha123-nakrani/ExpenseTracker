@model ExpenseTracker.Model.Budget

@{
    ViewData["Title"] = "Delete Budget";
}

<div class="finance-container bg-light p-4 rounded-3">
    <div class="finance-header d-flex justify-content-between align-items-center mb-4">
        <h2 style="color:crimson; font-weight:bold"><i class="fas fa-trash-alt me-2"></i>Delete Budget</h2>
    </div>

   
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h4 style="color:crimson; font-weight:600; text-shadow:inherit" class="mb-4">Are you sure you want to delete this budget?</h4>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold" style="color:black">Category</label>
                    <div class="form-control-plaintext border-bottom">@Model.Category.Name</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold" style="color:black">Amount</label>
                    <div class="form-control-plaintext border-bottom">₹ @Model.Amount.ToString("N2")</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold" style="color:black">Month</label>
                    <div class="form-control-plaintext border-bottom">
                        @(Model.Month != 0 ? System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month) : "Yearly")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold" style="color:black">Year</label>
                    <div class="form-control-plaintext border-bottom">@Model.Year</div>
                </div>
            </div>

            <form asp-action="Delete" class="form-actions">
                <input type="hidden" asp-for="BudgetID" />
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash-alt me-2"></i>Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Cancel
                </a>
            </form>
        </div>
    </div>
</div>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
    </div>
}
