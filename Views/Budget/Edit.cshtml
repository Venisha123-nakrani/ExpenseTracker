@model ExpenseTracker.Model.Budget
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Edit Budget";
}

<div class="finance-container bg-light p-4 rounded-3">
    <div class="finance-header d-flex justify-content-between align-items-center mb-4">
        <h2 style="color:#198754; font-weight:bold"><i class="fas fa-edit me-2"></i>Edit Budget</h2>
    </div>

   

    <form asp-action="Edit" method="post" class="needs-validation" novalidate>
        <input type="hidden" asp-for="BudgetID" />

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold" style="color:black">User Email</label>
                        <input type="email" class="form-control" value="@ViewData["UserEmail"]" readonly />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoryID" class="form-label fw-bold" style="color:black">Category</label>
                        <select asp-for="CategoryID" class="form-select" asp-items="ViewBag.ExpenseCategoryID" required>
                            <option value="">-- Select Category --</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Amount" class="form-label fw-bold" style="color:black">Budget Amount (₹)</label>
                        <input asp-for="Amount" type="number" class="form-control" required min="1" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Month" class="form-label fw-bold" style="color:black">Month (Optional)</label>
                        <select asp-for="Month" class="form-select">
                            <option value="0">-- Whole Year --</option>
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Year" class="form-label fw-bold" style="color:black">Year</label>
                        <input asp-for="Year" type="number" class="form-control" required />
                    </div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save me-2"></i>Update
            </button>
            <a asp-action="Index" class="btn btn-secondary" style="background-color:#4154f1">
                <i class="fas fa-times me-2"></i>Cancel
            </a>
        </div>
    </form>
</div>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}