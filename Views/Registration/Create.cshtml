<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">

  <title>Pages / Register</title>
  <meta content="" name="description">
  <meta content="" name="keywords">

  <!-- Favicons -->
    <link href="~/assets_db/img/favicon.png" rel="icon">
    <link href="~/assets_db/img/apple-touch-icon.png" rel="apple-touch-icon">

  <!-- Google Fonts -->
  <link href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Nunito:300,300i,400,400i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

  <!-- Vendor CSS Files -->
    <link href="~/assets_db/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets_db/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets_db/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
    <link href="~/assets_db/vendor/quill/quill.snow.css" rel="stylesheet">
    <link href="~/assets_db/vendor/quill/quill.bubble.css" rel="stylesheet">
    <link href="~/assets_db/vendor/remixicon/remixicon.css" rel="stylesheet">
    <link href="~/assets_db/vendor/simple-datatables/style.css" rel="stylesheet">

  <!-- Template Main CSS File -->
    <link href="~/assets_db/css/style.css" rel="stylesheet">

  <!-- =======================================================
  * Template Name: NiceAdmin
  * Template URL: https://bootstrapmade.com/nice-admin-bootstrap-admin-html-template/
  * Updated: Apr 20 2024 with Bootstrap v5.3.3
  * Author: BootstrapMade.com
  * License: https://bootstrapmade.com/license/
  ======================================================== -->
</head>

<body>

    <main>
        <div class="container">
            <section class="section register min-vh-100 d-flex flex-column align-items-center justify-content-center py-4">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-4 col-md-6 d-flex flex-column align-items-center justify-content-center">
                            <div class="card mb-3">
                                <div class="card-body">
                                    <div class="pt-4 pb-2">
                                        <h5 class="card-title text-center pb-0 fs-4">Create an Account</h5>
                                        <p class="text-center small">Enter your details to register</p>
                                    </div>

                                    <form asp-action="Create" method="post" enctype="multipart/form-data" class="row g-3 needs-validation" novalidate>
                                        @Html.AntiForgeryToken()
                                        <div asp-validation-summary="All" class="text-danger text-center"></div>

                                        <div class="col-12">
                                            <label asp-for="FullName" class="form-label">Full Name</label>
                                            <input asp-for="FullName" type="text" class="form-control" required>
                                            <div class="invalid-feedback">Please enter your full name!</div>
                                        </div>

                                        <div class="col-12">
                                            <label asp-for="Email" class="form-label">Email</label>
                                            <input asp-for="Email" type="email" class="form-control" required>
                                            <div class="invalid-feedback">Please enter a valid email address!</div>
                                        </div>

                                        <div class="col-12">
                                            <label asp-for="Password" class="form-label">Password</label>
                                            <input asp-for="Password" type="password" class="form-control" required>
                                            <div class="invalid-feedback">Please enter a password!</div>
                                        </div>

                                        <div class="col-12">
                                            <label for="cpassword" class="form-label">Confirm Password</label>
                                            <input name="cpassword" type="password" class="form-control" required>
                                            <div class="invalid-feedback">Please confirm your password!</div>
                                            <span class="text-danger">@Html.ValidationMessage("cpassword")</span>
                                        </div>

                                        <div class="col-12">
                                            <label asp-for="BirthDate" class="form-label">Birthdate</label>
                                            <input asp-for="BirthDate" type="date" class="form-control">
                                        </div>

                                        <div class="col-12">
                                            <label asp-for="Address" class="form-label">Address</label>
                                            <input asp-for="Address" type="text" class="form-control">
                                        </div>

                                        <div class="col-12">
                                            <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                                            <input asp-for="PhoneNumber" type="text" class="form-control">
                                        </div>

                                        <div class="col-12">
                                            <label asp-for="Country" class="form-label">Country</label>
                                            <input asp-for="Country" type="text" class="form-control">
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label">Profile Image</label>
                                            <input type="file" name="ImageFile" class="form-control">
                                        </div>

                                        <div class="col-12">
                                            <div class="form-check">
                                                <input class="form-check-input" name="terms" type="checkbox" required>
                                                <label class="form-check-label">
                                                    I agree and accept the <a href="#">terms and conditions</a>
                                                </label>
                                                <div class="invalid-feedback">You must agree before submitting.</div>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <button class="btn btn-primary w-100" type="submit">Create Account</button>
                                        </div>

                                        <div class="col-12 text-center mt-2">
                                            <p class="small mb-0">Already have an account? <a asp-controller="Login" asp-action="Login" class="text-primary">Log in</a></p>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

  <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Vendor JS Files -->
    <script src="~/assets_db/vendor/apexcharts/apexcharts.min.js"></script>
    <script src="~/assets_db/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets_db/vendor/chart.js/chart.umd.js"></script>
    <script src="~/assets_db/vendor/echarts/echarts.min.js"></script>
    <script src="~/assets_db/vendor/quill/quill.js"></script>
    <script src="~/assets_db/vendor/simple-datatables/simple-datatables.js"></script>
    <script src="~/assets_db/vendor/tinymce/tinymce.min.js"></script>
    <script src="~/assets_db/vendor/php-email-form/validate.js"></script>

  <!-- Template Main JS File -->
    <script src="~/assets_db/js/main.js"></script>

</body>

</html>