@{
}
@* Views/RecurringExpense/Delete.cshtml *@
@model ExpenseTracker.Model.RecurringExpense

@{
    ViewData["Title"] = "Delete Recurring Expense";
}

<h2> 🗑️ Delete Recurring Expense</h2>

<h4>Are you sure you want to delete this recurring expense?</h4>
<hr />
<dl class="row">
    <dt class="col-sm-2">Category</dt>
    <dd class="col-sm-10">@Model.Category?.Name</dd>

    <dt class="col-sm-2">Payment Mode</dt>
    <dd class="col-sm-10">@Model.Payment?.Name</dd>

    <dt class="col-sm-2">Amount</dt>
    <dd class="col-sm-10">@Model.Amount</dd>

    <dt class="col-sm-2">Start Date</dt>
    <dd class="col-sm-10">@Model.StartDate</dd>

    <dt class="col-sm-2">End Date</dt>
    <dd class="col-sm-10">@Model.EndDate?.ToString("dd-MM-yyyy")</dd>

    <dt class="col-sm-2">Date of Month</dt>
    <dd class="col-sm-10">@Model.DateOfMonth</dd>

    <dt class="col-sm-2">Active</dt>
    <dd class="col-sm-10">@(Model.IsActive ? "Yes" : "No")</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="RecurringID" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">❌ Cancel</a>
</form>

