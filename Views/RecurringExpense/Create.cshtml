@{
}
@model ExpenseTracker.Model.RecurringExpense

@{
    ViewData["Title"] = "Create Recurring Expense";
}

<h2>⨁ Create Recurring Expense</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label>Category</label>
        <select asp-for="CategoryID" class="form-control" asp-items="ViewBag.Categories"></select>
    </div>

    <div class="form-group">
        <label>Amount</label>
        <input asp-for="Amount" class="form-control" type="number" step="0.01" required />
    </div>

    <div class="form-group">
        <label>Payment Mode</label>
        <select asp-for="PaymentModeID" class="form-control" asp-items="ViewBag.Payments"></select>
    </div>

    <div class="form-group">
        <label>Start Date</label>
        <input asp-for="StartDate" type="date" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Optional End Date</label>
        <input asp-for="EndDate" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label>Trigger Day (e.g., 3 for 3rd of every month)</label>
        <input asp-for="DateOfMonth" type="number" min="1" max="28" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Frequency</label>
        <input asp-for="Frequency" class="form-control" placeholder="e.g., Monthly" />
    </div>
    <br/>
    <div class="form-group">
        <label>Is Active</label>
        <input asp-for="IsActive" type="checkbox" />
    </div>

    <button type="submit" class="btn btn-primary">Create✔</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel❌</a>
</form>
