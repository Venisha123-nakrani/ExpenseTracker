        <script>
            //Theme Selector
                    document.addEventListener("DOMContentLoaded", function () {
                let themeSelector = document.getElementById("themeSelector");
                let currentTheme = localStorage.getItem("theme") || "light";

                // Apply the selected theme
                function applyTheme(theme) {
                    let root = document.documentElement;
                    switch (theme) {
                        case "dark":
                            root.style.setProperty("--bg-color", "#121212");
                            root.style.setProperty("--card-bg", "#1E1E1E");
                            root.style.setProperty("--text-color", "#FFFFFF");
                            break;
                        case "light":
                            root.style.setProperty("--bg-color", "#F4F4F4");
                            root.style.setProperty("--card-bg", "#FFFFFF");
                            root.style.setProperty("--text-color", "#333333");
                            break;
                        case "blue":
                            root.style.setProperty("--bg-color", "#E3F2FD");
                            root.style.setProperty("--card-bg", "#FFFFFF");
                            root.style.setProperty("--text-color", "#0D47A1");
                            break;
                        case "green":
                            root.style.setProperty("--bg-color", "#E8F5E9");
                            root.style.setProperty("--card-bg", "#FFFFFF");
                            root.style.setProperty("--text-color", "#1B5E20");
                            break;
                    }
                    localStorage.setItem("theme", theme);
                }

                // Apply the theme from localStorage
                applyTheme(currentTheme);
                themeSelector.value = currentTheme;

                // Change theme on selection
                themeSelector.addEventListener("change", function () {
                    applyTheme(this.value);
                });
            });

        </script>

