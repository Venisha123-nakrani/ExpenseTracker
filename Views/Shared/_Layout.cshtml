    <!-- Add this in <head> or just before your closing </body> tag -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

    <!-- 💬 Chatbot Toggle Button -->
    <button id="chatbot-toggle" class="btn btn-primary rounded-circle"
            style="position: fixed; bottom: 20px; right: 20px; z-index: 9999;">
        💬
    </button>

    <!-- 💬 Chatbot Container -->
    <div id="chatbot-container" class="card shadow"
         style="display:none; position: fixed; bottom: 80px; right: 20px; width: 300px; z-index: 9999;">
        <div class="card-header bg-primary text-white">
            ExpenseTracker Assistant 🤖
            <button type="button" class="btn-close btn-close-white float-end" aria-label="Close"
                    onclick="$('#chatbot-container').hide();"></button>
        </div>
        <div class="card-body" style="max-height: 300px; overflow-y: auto;" id="chatbot-messages">
            <div class="text-muted">Ask anything about your expenses, income, budgets, etc.</div>
        </div>
        <div class="card-footer">
            <div class="input-group">
                <input type="text" id="chatbot-input" class="form-control" placeholder="Type your question..." />
                <button class="btn btn-primary" onclick="sendToBot()">Send</button>
            </div>
        </div>
    </div>

    <!-- ✅ Script (ensure jQuery is already loaded before this) -->
    <script>
        $(document).ready(function () {
            $('#chatbot-toggle').click(function () {
                $('#chatbot-container').toggle();
            });
        });

        function appendMessage(role, text) {
            const messageClass = role === 'user' ? 'text-end text-primary' : 'text-start text-dark';
            $('#chatbot-messages').append(`<div class="${messageClass} my-2"><strong>${role}:</strong> ${text}</div>`);
            $('#chatbot-messages').scrollTop($('#chatbot-messages')[0].scrollHeight);
        }

        function sendToBot() {
            const input = $('#chatbot-input').val().trim();
            if (!input) return;

            appendMessage('user', input);
            $('#chatbot-input').val('');

            const sendButton = $('#chatbot-container button:contains("Send")');
            sendButton.prop('disabled', true);

            fetch('/ChatBot/Ask', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ message: input })
            })
            .then(res => {
                if (!res.ok) throw new Error('Server error');
                return res.json();
            })
            .then(data => {
                if (data.reply) {
                    appendMessage('bot', data.reply);
                } else {
                    appendMessage('bot', '⚠️ No reply from the AI.');
                }
            })
            .catch(err => {
                console.error(err);
                appendMessage('bot', '❌ Error contacting the assistant.');
            })
            .finally(() => {
                sendButton.prop('disabled', false);
            });
        }
    </script>


