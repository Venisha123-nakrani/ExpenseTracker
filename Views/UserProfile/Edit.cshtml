@model ExpenseTracker.Model.User


<div class="container profile-container">
    <div class="card shadow-lg">
        <div class="card-body">
            <h4>Edit Profile</h4>
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-6">
                        <!-- Full Name -->
                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <input type="text" class="form-control" asp-for="FullName">
                        </div>

                        <!-- Email (Read-Only) -->
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" asp-for="Email" readonly>
                        </div>

                        <!-- Birth Date -->
                        <div class="mb-3">
                            <label class="form-label">Birth Date</label>
                            <input type="date" class="form-control" asp-for="BirthDate">
                        </div>

                        <!-- Phone Number -->
                        <div class="mb-3">
                            <label class="form-label">Phone Number</label>
                            <input type="text" class="form-control" asp-for="PhoneNumber">
                        </div>
                    </div>

                    <div class="col-md-6">
                        <!-- Address -->
                        <div class="mb-3">
                            <label class="form-label">Address</label>
                            <input type="text" class="form-control" asp-for="Address">
                        </div>

                        <!-- Country -->
                        <div class="mb-3">
                            <label class="form-label">Country</label>
                            <input type="text" class="form-control" asp-for="Country">
                        </div>

                        <!-- Image Upload -->
                        <div class="mb-3">
                            <label class="form-label">Profile Image</label>
                            <input type="file" class="form-control" name="imageFile">
                        </div>

                        <!-- Account Created On (Read-Only) -->
                        <div class="mb-3">
                            <label class="form-label">Account Created On</label>
                            <input type="text" class="form-control" value="@Model.CreatedAt.ToString("dd-MM-yyyy")" readonly>
                        </div>

                        <!-- Submit and Cancel Buttons -->
                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">Save Changes ✔</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancel ✖</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
